{
  "name": "planb-orchestra",
  "version": "1.0.0",
  "description": "Simulated Alexa+-style household planning agent that repairs schedules when life changes, with a deterministic, independently validated constraint engine.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/app.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:smoke": "node tests/smoke/browser-smoke.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "audit:screens": "node tests/smoke/populated-audit.mjs",
    "test:qa": "node tests/smoke/release-qa.mjs",
    "test:nav": "node tests/smoke/nav-qa.mjs",
    "audit:responsive": "node tests/smoke/responsive-audit.mjs",
    "test:chat": "node tests/smoke/chat-qa.mjs",
    "test:scroll": "node tests/smoke/scroll-qa.mjs",
    "build": "node scripts/build.mjs",
    "start:dist": "node server/start-dist.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:create": "node tests/smoke/create-qa.mjs"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
